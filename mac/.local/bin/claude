#!/usr/bin/env bash
set -euo pipefail

wrapper_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
wrapper_path="$wrapper_dir/$(basename -- "${BASH_SOURCE[0]}")"

find_real_claude() {
  local path_dir candidate
  IFS=':' read -r -a path_parts <<< "${PATH:-}"
  for path_dir in "${path_parts[@]}"; do
    [[ -n "$path_dir" ]] || path_dir='.'
    candidate="$path_dir/claude"
    [[ -x "$candidate" && ! -d "$candidate" ]] || continue
    [[ "$candidate" != "$wrapper_path" ]] || continue
    [[ "$path_dir" != "$wrapper_dir" ]] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

real_claude="$(find_real_claude || true)"
if [[ -z "$real_claude" ]]; then
  printf 'claude wrapper: could not find the real Claude CLI on PATH after %s\n' "$wrapper_path" >&2
  printf 'Install Claude Code or put its executable on PATH after ~/.local/bin.\n' >&2
  exit 127
fi

if [[ "${CLAUDE_LOG_WRAPPED:-}" == "1" ]]; then
  exec "$real_claude" "$@"
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  exec "$real_claude" "$@"
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
repo_name="$(basename -- "$repo_root")"
branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
[[ -n "$branch" ]] || branch="detached"
branch="${branch//\//_}"

stamp="$(date +%Y%m%d-%H%M%S)"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
log_dir="$state_home/claude-sessions/$repo_name"
mkdir -p "$log_dir"

log_file="$log_dir/${stamp}-${branch}-$$.ansi.log"
meta_file="$log_file.meta"

{
  printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'cwd=%s\n' "$PWD"
  printf 'repo_root=%s\n' "$repo_root"
  printf 'repo_name=%s\n' "$repo_name"
  printf 'branch=%s\n' "$branch"
  printf 'real_claude=%s\n' "$real_claude"
  printf 'log_file=%s\n' "$log_file"
} > "$meta_file"

printf 'Logging Claude session to %s\n' "$log_file" >&2

export CLAUDE_LOG_WRAPPED=1
exec /usr/bin/script -q -a -t 1 "$log_file" "$real_claude" "$@"
